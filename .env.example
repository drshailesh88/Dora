# =============================================================================
# DORA - DocAssist Medical Knowledge Platform
# Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Providers (at least one required)
# -----------------------------------------------------------------------------

# OpenAI (for GPT-4o synthesis)
OPENAI_API_KEY=sk-...

# Anthropic (for Claude - recommended for medical reasoning)
ANTHROPIC_API_KEY=sk-ant-...

# Cohere (for reranking - highly recommended)
COHERE_API_KEY=...

# -----------------------------------------------------------------------------
# Local LLM (Ollama - for offline mode)
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# -----------------------------------------------------------------------------
# Vector Database
# -----------------------------------------------------------------------------

# Qdrant (recommended for production)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=  # Optional, for Qdrant Cloud

# ChromaDB (for local/offline)
CHROMA_PERSIST_DIR=./data/chroma

# -----------------------------------------------------------------------------
# Graph Database (optional, for UMLS relationships)
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# -----------------------------------------------------------------------------
# Embedding Models
# -----------------------------------------------------------------------------

# PubMedBERT for medical literature (default)
EMBEDDING_MODEL=NeuML/pubmedbert-base-embeddings
EMBEDDING_DIMENSION=768

# Alternative: all-MiniLM-L6-v2 for faster/smaller
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIMENSION=384

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------

# API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Retrieval
DENSE_TOP_K=20
SPARSE_TOP_K=20
RRF_K=60
RERANK_TOP_K=10

# Chunking
CHUNK_SIZE=1024
CHUNK_OVERLAP=150

# -----------------------------------------------------------------------------
# EMR Integration (optional)
# -----------------------------------------------------------------------------
EMR_DATABASE_PATH=  # Path to DocAssist EMR SQLite database
EMR_SYNC_ENABLED=false

# -----------------------------------------------------------------------------
# Voice (optional)
# -----------------------------------------------------------------------------
VOICE_ENABLED=false
WAKE_WORD=hey_docassist
WHISPER_MODEL=base.en

# -----------------------------------------------------------------------------
# Licensing & Analytics
# -----------------------------------------------------------------------------
LICENSE_SERVER_URL=https://license.docassist.in
TELEMETRY_ENABLED=true  # Anonymous usage stats
